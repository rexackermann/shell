#!/usr/bin/env bash
# Runs shellupgit, then syncs the author's other repos exactly as the
# previous all-in-one script did. Each step skips cleanly if a directory is absent.
set -u
here=$(cd "$(dirname "$0")" && pwd)
"$here/shellupgit"

sync_repo() { # sync_repo <dir> [commit-all]
  cd "$1" 2>/dev/null || { echo "skip: $1"; return 0; }
  git fetch && git pull && git add . && git commit -am "update_$(date +%s)" && git push
}

cp -rfv ~/.config/doom/* ~/github/rexdoom/ 2>/dev/null
cp -rfv ~/org/doomemacs.org ~/github/rexdoom/ 2>/dev/null
sync_repo ~/github/rexdoom

cp -rfv "$(command -v autowallp | head -n 1)" ~/github/autowallp/autowallp 2>/dev/null
cp -rfv "$(command -v wallch | head -n 1)" ~/github/autowallp/wallch 2>/dev/null
cp -rfv ~/org/bashscripts/autowallp.org ~/github/autowallp/README.org 2>/dev/null
sync_repo ~/github/autowallp

for d in ~/github/RexAckermann.github.io/shell ~/github/RexAckermann.github.io/rexdoom \
         ~/github/RexAckermann.github.io/autowallp ~/github/RexAckermann.github.io ~/.config/mpv; do
  cd "$d" 2>/dev/null || { echo "skip: $d"; continue; }
  git fetch && git pull && git commit -am "update_$(date +%s)" && git push
done
