#!/usr/bin/env bash
# Sync the live shell setup into this repo and push it.
#   - regenerates .zshrc/.zshenv/.profile/zimrc/.p10k.zsh from zshrc.org
#   - refuses to push if any generated file fails `zsh -n`
#   - re-encrypts history/private config (key stays OUTSIDE the repo)
#   - stages only what .gitignore allows (never `git add ./.*`)
set -euo pipefail

REPO=${REX_SHELL_REPO:-$HOME/github/shell}
ORG_SRC=${REX_ORG_SRC:-$HOME/org/zshrc.org}
ZD=${ZDOTDIR:-$HOME/.config/zsh}
RECIPIENT=${REX_GPG_RECIPIENT:-99F754553DF4C8382876F1F48422C956454840EB}
export GNUPGHOME=${GNUPGHOME:-${XDG_DATA_HOME:-$HOME/.local/share}/gnupg}

cd "$REPO"

# 1) Org source of truth (a newer copy in ~/org wins).
if [[ -f $ORG_SRC && $ORG_SRC -nt zshrc.org ]]; then
  cp -v -- "$ORG_SRC" zshrc.org
fi

# 2) Regenerate + verify.
python3 tools/tangle.py --check zshrc.org . || { echo "tangle/syntax check failed; not pushing" >&2; exit 1; }
command -v pandoc >/dev/null 2>&1 && python3 tools/build-readme.py zshrc.org README.md || echo "pandoc not found; CI will rebuild README.md"

# 3) Encrypted history/private (only if the key exists in $GNUPGHOME).
encrypt() { # encrypt <src> <dest-in-repo>
  [[ -f $1 ]] || return 0
  gpg --batch --yes -e -r "$RECIPIENT" -o "$2" "$1"
}
if command -v gpg >/dev/null 2>&1 && gpg --list-keys "$RECIPIENT" >/dev/null 2>&1; then
  encrypt "$ZD/history"        .zsh_history.gpg
  encrypt "$ZD/.zshrc_private" .zsh_private.gpg
else
  echo "gpg key $RECIPIENT not found in $GNUPGHOME; leaving encrypted blobs untouched"
fi

# 4) Helper scripts kept in sync as before (skipped when absent).
copy_if() { [[ -f $1 ]] && cp -fv -- "$1" "$2" || true; }
copy_if "$HOME/Documents/BashScript/csp"        bin/c
copy_if "$HOME/Documents/BashScript/shellupgit" shellupgit
copy_if "$(command -v psapp 2>/dev/null | head -n 1)" bin/psapp

# 5) Commit + push.
git add -A
git status --short
if git diff --cached --quiet; then
  echo "nothing to commit"
else
  git commit -m "update_$(date +%s)"
fi
git pull --rebase --autostash
git push
