#!/bin/bash

# Configuration (Arrays for multiple mounts)
REMOTE_USERS=("root" "truenas_admin" "rex" "root" "truenas_admin" "rex")
REMOTE_HOSTS=("192.168.1.195" "192.168.1.242" "192.168.1.242" "100.93.66.127" "100.91.40.69" "100.91.40.69")
REMOTE_PATHS=("/" "/" "/mnt/pool1/dr1/rex/" "/" "/" "/mnt/pool1/dr1/rex/")
LOCAL_MOUNT_POINTS=("/home/rex/AnDroid/" "/home/rex/truenasroot/" "/home/rex/dr1/" "/home/rex/AnDroid/" "/home/rex/truenasroot/" "/home/rex/dr1/")
# SSHFS_OPTIONS="-o allow_other,reconnect,ServerAliveInterval=15,ServerAliveCountMax=3"
SSHFS_OPTIONS=""

# Function to mount a single SSHFS share
mount_sshfs() {
  local remote_user="$1"
  local remote_host="$2"
  local remote_path="$3"
  local local_mount_point="$4"

  while true; do
    if sshfs "$remote_user@$remote_host:$remote_path" "$local_mount_point" $SSHFS_OPTIONS; then
      echo "SSHFS $local_mount_point mounted successfully."
      return 0
    else
      echo "SSHFS $local_mount_point mount failed. Retrying in 30 seconds..."
      sleep 30
    fi
  done
}

# Function to check and remount a single share
check_and_remount() {
  local local_mount_point="$1"

  while true; do
    if ! mountpoint -q "$local_mount_point"; then
      echo "SSHFS $local_mount_point disconnected. Remounting..."
      # Find the corresponding mount details
      local index=$(find_index "$local_mount_point")
      if [[ $index -ge 0 ]]; then
        mount_sshfs "${REMOTE_USERS[$index]}" "${REMOTE_HOSTS[$index]}" "${REMOTE_PATHS[$index]}" "$local_mount_point"
      else
          echo "Error: Mount point not found in configuration."
      fi
    fi
    sleep 10
  done
}

# Function to find the index of a mount point in the array
find_index() {
  local target="$1"
  for i in "${!LOCAL_MOUNT_POINTS[@]}"; do
    if [[ "${LOCAL_MOUNT_POINTS[$i]}" == "$target" ]]; then
      echo "$i"
      return 0
    fi
  done
  echo "-1"
  return 1
}

# Main script
for i in "${!LOCAL_MOUNT_POINTS[@]}"; do
  mkdir -p "${LOCAL_MOUNT_POINTS[$i]}"
  mount_sshfs "${REMOTE_USERS[$i]}" "${REMOTE_HOSTS[$i]}" "${REMOTE_PATHS[$i]}" "${LOCAL_MOUNT_POINTS[$i]}" &
  check_and_remount "${LOCAL_MOUNT_POINTS[$i]}" &
done

# Example systemd service file (for multiple mounts)
# /etc/systemd/system/multiple-sshfs-mount.service

# [Unit]
# Description=Mount multiple SSHFS shares
# After=network.target

# [Service]
# Type=forking
# ExecStart=/path/to/your/multiple_sshfs_script.sh
# Restart=on-failure
# RestartSec=30

# [Install]
# WantedBy=multi-user.target

# Then:
# sudo systemctl daemon-reload
# sudo systemctl enable multiple-sshfs-mount.service
# sudo systemctl start multiple-sshfs-mount.service
# sudo systemctl status multiple-sshfs-mount.service

# Important Notes:
# 1. Ensure the arrays are the same length.
# 2. Each element in the arrays corresponds to a single mount.
# 3. Adjust SSHFS options, paths, users, and hosts accordingly.
# 4. Same as the single mount script, ensure proper ssh key authentication, permissions, and logging.
