#!/bin/env zsh

zipfile="$(realpath "$1")"
echo "$zipfile"

tmpdir="$(mktemp -d)"

mkdir -p "$tmpdir"
echo "$tmpdir"

cd "$tmpdir"
pwd

unzip $zipfile -d ./

files="$( /bin/ls | awk '{
    priority = 0
    sort_key = $0

    # If the filename contains " (1)", remove it from the sort_key and set priority to 1.
    # We use a space before \(1\) to ensure we only match the intended pattern.
    if (sub(/ \(1\)/, "", sort_key)) {
        priority = 1
    }

    # Output: base_name|priority|original_line
    print sort_key "|" priority "|" $0
}' | \
sort -t'|' -k1,1 -k2,2n | \
cut -d'|' -f3- | sed "s/^/'/;s/$/'/" | tr '\n' ' ' )"

mkdir -p ~/Downloads/whatsapppdfs/

echo img2pdf "$files" -o ~/Downloads/whatsapppdfs/"$2" | bash
